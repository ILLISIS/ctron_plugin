{
	"name": "ctron_plugin",
	"version": "0.0.1",
	"description": "Constructrons across Clusterio instances: a controller job pool, and jobs that ride Universal Edges v2",
	"private": true,
	"type": "module",
	"main": "dist/node/index.js",
	"scripts": { "prepare": "tsc --build && webpack-cli --mode production", "test": "node --test \"dist/node/test/unit/**/*.test.js\" && lua5.2 ../universal_edges/test/unit/run.lua .. test/unit/*_test.lua" },
	"engines": { "node": ">=22" },
	"peerDependencies": {
		"@clusterio/controller": "workspace:^",
		"@clusterio/host": "workspace:^",
		"@clusterio/lib": "workspace:^"
	},
	"dependencies": {
		"@sinclair/typebox": "catalog:",
		"universal_edges": "workspace:*"
	},
	"devDependencies": {
		"@clusterio/controller": "workspace:^",
		"@clusterio/host": "workspace:^",
		"@clusterio/lib": "workspace:^",
		"@clusterio/web_ui": "workspace:^",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"antd": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"webpack": "catalog:",
		"webpack-cli": "catalog:",
		"webpack-merge": "catalog:"
	}
}
