{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "node16",
		"target": "es2022",
		"forceConsistentCasingInFileNames": true,
		"outDir": "dist/node"
	},
	"references": [
